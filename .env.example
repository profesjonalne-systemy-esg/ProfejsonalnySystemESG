# Skopiuj do .env (cp .env.example .env) i ewentualnie zmień hasło.
POSTGRES_USER=esg_user
POSTGRES_PASSWORD=esg_password
POSTGRES_DB=esg_database

# Logowanie (US 2.2): co najmniej 32 losowe znaki,
# np. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# true = praca lokalna bez logowania, na danych przykładowych
AUTH_DEMO=true
SEED_DEMO=true

# Klucze do modeli (Epik 4). Nie wrzucać do repozytorium.
OPENAI_API_KEY=
GEMINI_API_KEY=
